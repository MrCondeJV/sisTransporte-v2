APP_NAME="sisTransporte Cloud"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sistransporte.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single,daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base de datos central MySQL
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sistransporte_central
DB_USERNAME=sistransporte
DB_PASSWORD=SecretProdPass2026

# Conexión para migración ETL de sistema legado
DB_LEGACY_HOST=127.0.0.1
DB_LEGACY_PORT=3306
DB_LEGACY_DATABASE=transporteprivado
DB_LEGACY_USERNAME=root
DB_LEGACY_PASSWORD=root

# Sesiones, Colas y Caché en Redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.sistransporte.com

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=sistransporte_cache

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Servidor WebSockets en Vivo (Laravel Reverb)
REVERB_APP_ID=849201
REVERB_APP_KEY=sistransporte_live_key
REVERB_APP_SECRET=sistransporte_live_secret
REVERB_HOST="sistransporte.com"
REVERB_PORT=443
REVERB_SCHEME="https"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Correo Transaccional (SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=notificaciones@sistransporte.com
MAIL_PASSWORD=tu_clave_de_aplicacion
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="notificaciones@sistransporte.com"
MAIL_FROM_NAME="${APP_NAME}"

